generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
  INCOMPLETE
}

enum AgentStatus {
  ACTIVE
  IDLE
  ERROR
  DISABLED
}

enum AgentModel {
  GPT4
  GPT4_TURBO
  CLAUDE_3_OPUS
  CLAUDE_3_SONNET
  GEMINI_PRO
  GEMINI_ULTRA
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuditStatus {
  PENDING
  SCANNING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  AI
}

enum NotificationType {
  AGENT_COMPLETE
  REVIEW_FINISHED
  TICKET_ASSIGNED
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRING
  TEAM_INVITE
  AUDIT_COMPLETE
  SYSTEM_ALERT
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  clerkId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMember[]
  notifications Notification[]
  auditLogs     AuditLog[]
  agents        Agent[]
  ticketTasks   TicketTask[]
  apiKeys       ApiKey[]
  reviews       CodeReview[]
  tickets       CustomerTicket[]

  @@index([email])
  @@index([clerkId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  agents         Agent[]
  reviews        CodeReview[]
  pullRequests   PullRequest[]
  customerTickets CustomerTicket[]
  projects       Project[]
  ctoSessions    CTOSession[]
  prds           PRD[]
  roadmaps       Roadmap[]
  businessTasks  BusinessTask[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  subscription   Subscription?

  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           UserRole @default(DEVELOPER)
  joinedAt       DateTime @default(now())
  organizationId String
  userId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Plan {
  id          String   @id @default(cuid())
  type        PlanType @unique
  name        String
  description String
  price       Int      // cents
  interval    String   @default("month")
  stripePriceId String?

  maxAgents      Int   @default(1)
  maxTokensPerDay Int  @default(10000)
  maxTeamSeats   Int   @default(0)
  maxProjects    Int   @default(1)
  features       Json  @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                String             @id @default(cuid())
  organizationId    String             @unique
  planType          PlanType           @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  stripeCustomerId  String?
  stripeSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt       DateTime?
  tokensUsedToday   Int                @default(0)
  tokenResetDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planType], references: [type])

  invoices Invoice[]

  @@index([organizationId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id                String   @id @default(cuid())
  subscriptionId    String
  stripeInvoiceId   String?
  amount            Int
  currency          String   @default("usd")
  status            String   @default("pending")
  paidAt            DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  pdfUrl            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Agent {
  id             String     @id @default(cuid())
  name           String
  description    String?
  model          AgentModel @default(GPT4_TURBO)
  status         AgentStatus @default(IDLE)
  temperature    Float      @default(0.7)
  systemPrompt   String?
  tools          Json       @default("[]")
  configuration  Json       @default("{}")
  tokensUsed     Int        @default(0)
  totalCost      Float      @default(0)
  lastUsedAt     DateTime?
  createdBy      String
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User         @relation(fields: [createdBy], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         AgentLog[]
  permissions  AgentPermission[]

  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
}

model AgentLog {
  id        String   @id @default(cuid())
  agentId   String
  action    String
  input     String?
  output    String?
  tokensUsed Int     @default(0)
  cost      Float    @default(0)
  duration  Int?     // ms
  status    String   @default("SUCCESS")
  metadata  Json     @default("{}")

  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([createdAt])
}

model AgentPermission {
  id        String   @id @default(cuid())
  agentId   String
  resource  String
  action    String
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, resource, action])
}

model CodeReview {
  id          String       @id @default(cuid())
  pullRequestId String? @unique
  prTitle     String?
  prUrl       String?
  branch      String?
  repo        String?
  organizationId String
  reviewerId  String?
  status      ReviewStatus @default(PENDING)
  qualityScore Float?
  summary     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     User?         @relation(fields: [reviewerId], references: [id])
  issues       CodeIssue[]
  pullRequest  PullRequest? @relation(fields: [pullRequestId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([pullRequestId])
}

model CodeIssue {
  id          String   @id @default(cuid())
  reviewId    String
  file        String?
  line        Int?
  column      Int?
  severity    Severity @default(MEDIUM)
  category    String?  // security, performance, style, bug, best-practice
  title       String
  description String?
  suggestion  String?
  code        String?
  isFixed     Boolean  @default(false)

  createdAt DateTime @default(now())

  review CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([severity])
}

model PullRequest {
  id             String   @id @default(cuid())
  githubId       String?
  prNumber       Int?
  repoUrl        String?
  title          String
  url            String?
  repo           String?
  branch         String?
  baseBranch     String?
  author         String?
  additions      Int      @default(0)
  deletions      Int      @default(0)
  filesChanged   Int      @default(0)
  status         String   @default("open")
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       CodeReview?

  @@index([organizationId])
  @@index([githubId])
  @@unique([repoUrl, prNumber])
}

model Integration {
  id        String   @id @default(cuid())
  type      String            // "GITHUB", "GITLAB"
  orgId     String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([type])
}

model Project {
  id             String     @id @default(cuid())
  name           String
  repoUrl        String
  techStack      String[]
  description    String?    @db.Text
  healthScore    Int?
  lastAuditAt    DateTime?
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits        Audit[]
  businessTasks BusinessTask[]

  @@index([organizationId])
}

model Audit {
  id         String       @id @default(cuid())
  projectId  String
  status     AuditStatus  @default(PENDING)
  healthScore Int?
  summary    String?      @db.Text
  report     String?      @db.Text
  createdAt  DateTime     @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vulns   Vulnerability[]
  deps    Dependency[]
  perf    PerfMetric?

  @@index([projectId])
}

model Vulnerability {
  id          String @id @default(cuid())
  auditId     String
  severity    String
  cveId       String?
  title       String
  description String @db.Text
  fix         String? @db.Text

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model Dependency {
  id       String @id @default(cuid())
  auditId  String
  name     String
  current  String
  latest   String
  severity String

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model PerfMetric {
  id              String @id @default(cuid())
  auditId         String @unique
  bundleSize      String?
  lcp             String?
  tti             String?
  lighthouseScore Int?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model BusinessTask {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       String?    @default("medium")
  assigneeId     String?
  organizationId String
  projectId      String?
  dueDate        DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])
  tickets      CustomerTicket[]

  @@index([organizationId])
  @@index([status])
  @@index([assigneeId])
}

model CustomerTicket {
  id             String         @id @default(cuid())
  subject        String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  customerName   String?
  customerEmail  String?
  assigneeId     String?
  businessTaskId String?
  aiReplySuggested String?
  organizationId String
  body           String?
  resolvedAt     DateTime?
  metadata       Json           @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignee     User?          @relation(fields: [assigneeId], references: [id])
  businessTask BusinessTask?  @relation(fields: [businessTaskId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  emailThreads EmailThread[]
  messages     Message[]
  tasks        TicketTask[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([organizationId])
}

model EmailThread {
  id        String   @id @default(cuid())
  ticketId  String
  from      String
  to        String
  subject   String
  body      String
  messageId String?
  isAiGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  ticket CustomerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Message {
  id        String      @id @default(cuid())
  ticketId  String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  ticket CustomerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketTask {
  id          String     @id @default(cuid())
  ticketId    String
  userId      String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ticket   CustomerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee User?          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model CTOSession {
  id             String   @id @default(cuid())
  title          String
  contextType    String
  organizationId String

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  messages   CTOMessage[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CTOMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  session CTOSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PRD {
  id             String   @id @default(cuid())
  title          String
  content        String   @db.Text
  status         String   @default("DRAFT")
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Roadmap {
  id             String   @id @default(cuid())
  title          String
  organizationId String
  createdAt      DateTime @default(now())

  milestones Milestone[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Milestone {
  id          String   @id @default(cuid())
  roadmapId   String
  title       String
  description String   @db.Text
  quarter     String
  status      String   @default("PLANNED")
  techTags    String[]
  effort      String   @default("M")
  order       Int

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  details        Json     @default("{}")
  ipAddress      String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  read      Boolean          @default(false)
  link      String?
  metadata  Json             @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ApiKey {
  id             String   @id @default(cuid())
  name           String
  key            String   @unique
  prefix         String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  organizationId String
  createdById    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([key])
  @@index([organizationId])
  @@index([prefix])
}
